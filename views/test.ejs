<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create User</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
    <div class="bg-white shadow-lg rounded-lg p-8 w-full max-w-md">
        <form action="/upload" method="post" class="space-y-4" enctype="multipart/form-data">
           
            
           
            
            <input type="file" name="myfile" class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-400" required>
            <input 
                type="submit" 
                value="Upload File" 
                class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 rounded cursor-pointer transition"
            >
        </form>

    </div>
</body>
</html>