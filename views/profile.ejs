<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-gray-100 min-h-screen flex flex-col items-center py-10">

 
  <div class="flex flex-col items-center space-y-4 mb-6">
    <div class="relative">
      <img 
        class="h-40 w-40 rounded-full border-4 border-white shadow-xl object-cover hover:scale-105 transition-transform duration-300" 
        src="/images/uploads/<%= user.profilepic %>" 
        alt="Profile Picture"
      >
      <span class="absolute bottom-2 right-2 h-5 w-5   rounded-full"></span>
    </div>
    <h1 class="text-2xl font-bold text-blue-600">Hey, <%= user.name %>!</h1>
    <a href="/logout" class="text-red-500 hover:underline">Log Out</a>
  </div>

  <div class="bg-white shadow-lg rounded-lg p-8 w-full max-w-md">
    <form action="/post" method="post" class="space-y-4">
      <label for="aboutpost" class="block text-gray-700 font-medium">What's on your mind?</label>
      <textarea 
        id="aboutpost" 
        name="content" 
        rows="4" 
        placeholder="Share your thoughts..." 
        class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-400 resize-none"
        required
      ></textarea>
      <input 
        type="submit" 
        value="Create Post" 
        class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 rounded cursor-pointer transition"
      >
    </form>
  </div>

  <!-- User Posts -->
  <div class="w-full max-w-md mt-8">
    <% user.posts.reverse().forEach(function(post){ %>
      <div class="post bg-gray-50 rounded-lg shadow-sm p-4 mb-6 overflow-hidden">
        <div class="flex items-center mb-2">
          <h4 class="font-semibold text-gray-800">@<%= user.username %></h4>
        </div>
        <p class="text-gray-700 mb-4 break-words"><%= post.content %></p>
        <div class="flex space-x-4">
          <a href="/like/<%= user._id %>" class="text-blue-500 hover:text-blue-700 font-medium transition">Like</a>
          <a href="#" class="text-green-500 hover:text-green-700 font-medium transition">Edit</a>
        </div>
      </div>
    <% }); %>
  </div>

</body>
</html>
